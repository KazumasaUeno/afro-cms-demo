rules_version = '2';

// A1 のプレースホルダ: すべて拒否する。
// 本体は A2 で docs/design/BACKEND_FIREBASE.md §8・§28（security-engineer のレビュー後）どおりに書く。
// このファイルは firebase.json の firestore.rules としてデプロイ対象に入っている。
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
