{
  "name": "afro-cms-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "build:live": "tsc -p tsconfig.json && vite build --mode live",
    "build:emulator": "tsc -p tsconfig.json && vite build --mode emulator",
    "preview": "vite preview",
    "dev:emulator": "vite --mode emulator",
    "preview:emulator": "vite preview --mode emulator",
    "typecheck": "tsc -p tsconfig.json",
    "test:rules": "node scripts/test-rules.mjs",
    "test:functions": "node scripts/test-functions.mjs",
    "test:unit": "node --experimental-strip-types --no-warnings --import ./tests/unit/register.mjs --test \"tests/unit/*.test.mjs\"",
    "build:functions": "npm --prefix functions run build",
    "rules:gen": "node --experimental-strip-types --no-warnings scripts/gen-rules-questions.mjs",
    "ai:gen": "node scripts/gen-ai-shared.mjs",
    "ai:check": "node scripts/gen-ai-shared.mjs --check",
    "rules:check": "node --experimental-strip-types --no-warnings scripts/gen-rules-questions.mjs --check",
    "deploy:firebase": "node scripts/deploy-firebase.mjs",
    "emulators": "node scripts/emulators.mjs",
    "seed:emulator": "node scripts/seed-emulator.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@mui/material": "^5.18.0",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@xyflow/react": "^12.12.1",
    "firebase": "^13.2.0",
    "gsap": "^3.15.1",
    "html2canvas-pro": "2.6.3",
    "jspdf": "4.2.1",
    "lucide-react": "^1.68.0",
    "motion": "^14.9.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "firebase-tools": "^15.35.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
